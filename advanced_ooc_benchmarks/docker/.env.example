# Copy to .env and adjust. All values are optional; the defaults assume the
# SystemDS checkout sits next to the OOCExperiments checkout.

# Host uid/gid the benchmark user gets, so bind-mounted results stay writable.
BENCH_UID=1000
BENCH_GID=1000

# Repository root that is mounted at /workspace.
REPO_DIR=../..

# Dataset + results root, mounted at /bench/data and used as the plan's `root`.
# Point this at a directory on a real block device with enough free space; the
# dense sweep writes tens of GB of prepared SystemDS representations.
BENCH_DATA_DIR=./data

# Prebuilt SystemDS jar, mounted read-only at /opt/systemds/SystemDS.jar, and the
# dependency directory its manifest Class-Path points at. Both are required: the
# jar alone cannot start.
SYSTEMDS_JAR=../../../systemds/target/SystemDS.jar
SYSTEMDS_LIB_DIR=../../../systemds/target/lib

# The SystemDS Python bindings, installed into the venv on first use. Dataset
# preparation imports `systemds`; take the sources from the same checkout as the
# jar so the binding and the engine cannot drift apart.
SYSTEMDS_PYTHON_DIR=../../../systemds/src/main/python

# Local Spark arm. The shipped plan enables the systemds-spark template, which
# declares `required_tools: [spark_submit]`, so the preflight aborts unless this
# is true. Set it false only alongside disabling that template.
INSTALL_SPARK=true
PYSPARK_VERSION=3.5.3
JAVA_VERSION=21
SHM_SIZE=2gb
