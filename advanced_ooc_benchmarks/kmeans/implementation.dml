# Deterministic fixed-iteration Lloyd KMeans. Initializing from the first k
# records makes the SystemDS, NumPy, and Dask arms independent of their random
# number generators. Continuous benchmark data makes distance ties and empty
# clusters vanishingly unlikely; ties are shared during centroid updates.
m_kmeans_fixed = function(Matrix[Double] X, Integer k, Integer iterations)
  return (Matrix[Double] C, Matrix[Double] Y, Double inertia)
{
  C = X[1:k, ];
  sum_x_sq = sum(X ^ 2);

  for(i in 1:iterations) {
    D = -2 * (X %*% t(C)) + t(rowSums(C ^ 2));
    min_d = rowMins(D);
    P = D <= min_d;
    P = P / rowSums(P);
    counts = colSums(P);
    C = (t(P) %*% X) / t(counts);
  }

  D = -2 * (X %*% t(C)) + t(rowSums(C ^ 2));
  Y = rowIndexMin(D);
  inertia = sum_x_sq + sum(rowMins(D));
}
