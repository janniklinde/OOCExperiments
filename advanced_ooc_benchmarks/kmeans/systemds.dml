source("kmeans/implementation.dml") as kmeans_impl;

X = read($1);
[C, Y, inertia] = kmeans_impl::m_kmeans_fixed(
  X=X, k=as.integer($2), iterations=as.integer($3));

write(C, $4, format="binary");
write(Y, $5, format="binary");
print("inertia=" + inertia);
