source("lmcg/implementation.dml") as lmcg_impl;

X = read($1);
y = read($2);
[beta, residual_norm] = lmcg_impl::m_lmcg_fixed(
  X=X, y=y, reg=$3, iterations=as.integer($4), tolerance=$5);

write(beta, $6, format="binary");
print("residual_norm=" + residual_norm);
