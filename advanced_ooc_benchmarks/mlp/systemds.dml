source("mlp/implementation.dml") as fftrain_impl;

start = time();
X = read($1);
Y = read($2);
model = fftrain_impl::m_ffTrain(X=X, Y=Y, batch_size=$3, epochs=$4, learning_rate=$5,
  out_activation="sigmoid", loss_fcn="log_loss", shuffle=FALSE,
  validation_split=0, seed=$6, verbose=FALSE);
checksum = sum(as.matrix(model["W1"])) + sum(as.matrix(model["W2"]));
print("model checksum: " + checksum);
print("Total execution time: " + ((time()-start)/1000000));
