source("pca/implementation.dml") as pca_impl;

X = read($1);
[scores, components, eigenvalues] = pca_impl::m_pca_covariance(
  X=X, k=as.integer($2));

write(scores, $3, format="binary");
write(components, $4, format="binary");
write(eigenvalues, $5, format="binary");
print("score_checksum=" + sum(scores));
