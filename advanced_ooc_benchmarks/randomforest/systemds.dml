source("randomforest/implementation.dml") as randomforest_impl;

X = read($1);
y = read($2);
ctypes = cbind(matrix(1, rows=1, cols=ncol(X)), matrix(2, rows=1, cols=1));
M = randomforest_impl::m_randomForest(X=X, y=y, ctypes=ctypes,
  num_trees=$3, sample_frac=$4, feature_frac=1.0, max_depth=$5,
  min_leaf=$6, min_split=$7, max_features=0.5, max_values=1.0,
  impurity="gini", seed=$8, verbose=FALSE);

write(M, $9, format="binary");
